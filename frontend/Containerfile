# 阶段一：打包 Vue 项目
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# 阶段二：使用 Nginx 托管
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# 【关键修改】删掉原来那行 sed，换成下面这行，把我们的配置复制进去
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
